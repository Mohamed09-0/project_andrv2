<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voisinage+"
            android:textColor="#203D88"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Edit My Profile"
            android:textColor="#20252B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Profile photo -->
        <ImageView
            android:id="@+id/imgEditProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="25dp"
            android:background="#DDDDDD"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Profile photo" />

        <Button
            android:id="@+id/btnChoosePhoto"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="CHOOSE PHOTO"
            android:textColor="#FFFFFF"
            android:backgroundTint="#203D88" />

        <EditText
            android:id="@+id/edtEditPrenom"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="First name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edtEditNom"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Last name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/edtEditEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtEditLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Username"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtEditTelephone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Phone number"
            android:inputType="phone" />

        <EditText
            android:id="@+id/edtEditVille"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="City"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtEditQuartier"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:hint="Neighborhood"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="SAVE CHANGES"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#203D88" />

    </LinearLayout>

</ScrollView>
